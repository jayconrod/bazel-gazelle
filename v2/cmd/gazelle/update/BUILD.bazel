load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "update",
    srcs = [
        "diff.go",
        "fix.go",
        "fix-update.go",
        "metaresolver.go",
        "print.go",
    ],
    importpath = "github.com/bazel-contrib/bazel-gazelle/v2/cmd/gazelle/update",
    visibility = ["//visibility:public"],
    deps = [
        "//config",
        "//flag",
        "//language",
        "//repo",
        "//resolve",
        "//v2/cmd/gazelle/profile",
        "//v2/compat",
        "//v2/config",
        "//v2/internal/wspace",
        "//v2/label",
        "//v2/merger",
        "//v2/rule",
        "//v2/walk",
        "@com_github_bazelbuild_buildtools//build",
        "@com_github_pmezard_go_difflib//difflib",
    ],
)

go_test(
    name = "update_test",
    srcs = [
        "diff_test.go",
        "fix_test.go",
    ],
    data = [
        "@go_sdk//:ROOT",
        "@go_sdk//:files",
    ],
    x_defs = {"goRootFile": "$(rlocationpath @go_sdk//:ROOT)"},
    deps = [
        ":update",
        "//config",
        "//language/bazel/visibility",
        "//language/go",
        "//language/proto",
        "//resolve",
        "//v2/testtools",
        "//v2/walk",
        "@io_bazel_rules_go//go/runfiles",
    ],
)

filegroup(
    name = "all_files",
    testonly = True,
    srcs = [
        "BUILD.bazel",
        "diff.go",
        "diff_test.go",
        "fix.go",
        "fix-update.go",
        "fix_test.go",
        "metaresolver.go",
        "print.go",
    ],
    visibility = ["//visibility:public"],
)
